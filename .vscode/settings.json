{
  "typescript.preferences.autoImportFileExcludePatterns": ["react-native"],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/.expo": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/android": true,
    "**/ios": true
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  }
}
